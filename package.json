{
  "name": "bestiora-azur",
  "productName": "Bestiora Azur",
  "version": "1.0.0",
  "description": "RPG original de capture de créatures en pixel art 4 teintes.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "atlas": "node tools/build-atlas.js",
    "validate": "node tools/validate-data.js",
    "dist": "electron-builder",
    "bestiary": "node tools/export-bestiary-md.js",
    "map-preview": "node tools/map-preview.js",
    "simulate": "node tools/simulate-battle.js",
    "balance": "node tools/balance-check.js",
    "icon": "node tools/build-icon.js",
    "screenshots": "node tools/capture-screenshots.js",
    "check-text": "node tools/check-text-fit.js",
    "perf": "node tools/run-perf.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magend-Salocin/pokemon_blue.git"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0"
  },
  "allowScripts": {
    "electron@45.3.1": true
  },
  "build": {
    "appId": "fr.bestiora.azur",
    "productName": "Bestiora Azur",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "!src/debug/**",
      "!electron/dev-tasks.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.role-playing-games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
